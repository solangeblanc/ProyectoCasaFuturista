  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Helechos</b>: luz suave, el sustrato siempre h\xFAmedo.\r\n<b>Monstera</b>:
    luz brillante indirecta. \r\n<b>Orqu\xEDdeas</b>: luz filtrada. Riego: 1 vez
    por semana, sin dejar agua acumulada en el centro de la planta.\r\n<b>Aloe y
    suculentas</b>: sol directo. Riego: cada 2 a 3 semanas; no toleran el exceso
    de agua.\r\n<b>Cuidados generales</b>\r\n- Regar temprano o al atardecer, no
    con el sol fuerte sobre el vidrio.\r\n- El vidrio concentra el calor: ventilar
    en verano y proteger del fr\xEDo en invierno.\r\n- Revisar hojas y plagas una
    vez por semana."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
