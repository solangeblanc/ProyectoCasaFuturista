  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#66E680>Energia solar de la casa</color>\n \nInformaci\xF3n tecnica:\n-
    12 paneles de 550 W = 6,6 kw de potencia pico.\n- Inclinaci\xF3n 30 \xB0 orientaci\xF3n
    Norte.\n- Superficie 50 m2.\nGeneraci\xF3n estimada:\n- 22 km por d\xEDa (670
    kwh por mes)\n- 4,5 horas sol pico.\n- Rendimiento del 75 %.\nAlmacenamiento:\n-
    5 baterias de litio de 5,12 kwh \n- Total 25,6 kwh -  utilizables =23 kwh.\nAutomomia:\nEntre
    un dia y medio y 2 dias de consumo medio.\n\n<color=#66E680>Presiona [ESP] para
    abrir</color>\n"
