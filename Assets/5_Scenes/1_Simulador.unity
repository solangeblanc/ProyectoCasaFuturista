  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "**SISTEMA INTELIGENTE DE CARGA EL\xC9CTRICA**\r\n\r\nLa estaci\xF3n utiliza
    huellas solares integradas en el suelo que aprovechan la energ\xEDa del sol para
    generar electricidad y cargar los veh\xEDculos el\xE9ctricos.\r\n\r\nAdem\xE1s,
    cuenta con un surtidor de carga complementario que permite abastecer a los veh\xEDculos
    durante la noche o en d\xEDas nublados, cuando la generaci\xF3n de energ\xEDa
    solar es insuficiente.\r\n\r\n**ESTADO DE LOS VEH\xCDCULOS**\r\n\r\nLos dos autos
    se encuentran estacionados sobre las huellas solares y est\xE1n completamente
    cargados.\r\n\r\n**Carga actual de los autos: 100 %**"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
