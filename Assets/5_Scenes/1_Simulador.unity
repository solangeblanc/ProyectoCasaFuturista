  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "             <color=#66E680>Jard\xEDn de invierno: qu\xE9 cultivar y cuidados</color>\n\n<b>Helechos</b>:
    luz suave, el sustrato siempre h\xFAmedo.\n<b>Monstera</b>: luz brillante indirecta.
    \n<b>Orqu\xEDdeas</b>: luz filtrada. Riego: 1 vez por semana, sin dejar agua
    acumulada en el centro de la planta.\n<b>Aloe y suculentas</b>: sol directo.
    Riego: cada 2 a 3 semanas; no toleran el exceso de agua.\n<b>Cuidados generales</b>\n-
    Regar temprano o al atardecer, no con el sol fuerte sobre el vidrio.\n- El vidrio
    concentra el calor: ventilar en verano y proteger del fr\xEDo en invierno.\n-
    Revisar hojas y plagas una vez por semana.\n\n                           <color=#66E680>[ESP]
    Detener el riego</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
